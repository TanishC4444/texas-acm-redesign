# Browser configuration from Firebase > Project settings > Your apps.
# Firebase web config identifies the project; access is controlled by Security Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional legacy shared calendar integration
GOOGLE_CAL_ID=
GOOGLE_CAL_API_KEY=
# Server-only: service-account JSON, set in the hosting provider's secret store.
# Needed only for admin-provisioned officer invitations. Never use NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional local-only Figma capture; keep disabled normally.
NEXT_PUBLIC_FIGMA_CAPTURE=0
