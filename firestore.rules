rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mfa() {
      return signedIn() && request.auth.token.email_verified == true
        && 'sign_in_second_factor' in request.auth.token.firebase
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }
    function officer() {
      return mfa() && exists(/databases/$(database)/documents/officers/$(request.auth.uid))
        && get(/databases/$(database)/documents/officers/$(request.auth.uid)).data.active == true;
    }
    function admin() {
      return officer() && get(/databases/$(database)/documents/officers/$(request.auth.uid)).data.role == 'admin';
    }
    function safeLink(value) { return value is string && value.size() <= 2048 && (value == '' || value.matches('https://[^\\s]+')); }
    function validContent(data) {
      return data.keys().hasOnly(['kind','title','description','category','date','location','url','image','status','createdBy','updatedBy','createdAt','updatedAt'])
        && data.keys().hasAll(['kind','title','description','category','date','location','url','image','status','createdBy','updatedBy','createdAt','updatedAt'])
        && data.kind in ['event','announcement','resource','form']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 140
        && data.description is string && data.description.size() > 0 && data.description.size() <= 5000
        && data.category in ['Community','Academics','Industry','General']
        && data.date is string && data.date.size() <= 40
        && (data.date == '' || data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z'))
        && data.location is string && data.location.size() <= 200
        && safeLink(data.url) && safeLink(data.image)
        && data.status in ['draft','published','archived']
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    match /content/{id} {
      allow read: if resource.data.status == 'published' || officer();
      allow create: if officer() && validContent(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if officer() && validContent(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      // Archive instead of deleting. Preserve authorship and creation timestamps.
      allow delete: if false;
    }
    match /officers/{uid} {
      // A user can read their own approval while enrolling; it never grants content access without MFA.
      allow get: if (signedIn() && request.auth.uid == uid) || admin();
      allow list: if admin();
      allow create, update: if admin() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['name','email','role','active'])
        && request.resource.data.keys().hasAll(['name','email','role','active'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['admin','editor'] && request.resource.data.active is bool;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
