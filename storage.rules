rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function officer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && 'sign_in_second_factor' in request.auth.token.firebase
        && request.auth.token.firebase.sign_in_second_factor == 'totp'
        && firestore.exists(/databases/(default)/documents/officers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/officers/$(request.auth.uid)).data.active == true;
    }
    match /site-photos/{slot}/{file} {
      allow get: if true;
      allow create: if resource == null && officer()
        && slot in ['home','about','events','academics','industry','community','gallery-0','gallery-1','gallery-2','gallery-3']
        && file.matches('[a-f0-9-]{36}')
        && request.resource.size > 0
        && request.resource.size <= 6 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp'];
    }
  }
}
